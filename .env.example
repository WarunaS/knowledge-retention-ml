# Copy to .env (gitignored) as a reminder of what to set. The code does NOT read .env by itself:
# export these in your shell (local) or set them from Colab secrets (see docs/how_to_test.html).
ANTHROPIC_API_KEY=        # Stage 4b labelling, teacher run T, Claude extraction/answers (paid)
HF_TOKEN=                 # optional: higher Hugging Face rate limits when collecting data
KRS_DATA_ROOT=            # default: <repo>/data      (Colab: /content/drive/MyDrive/krs/data)
KRS_RESULTS_DIR=          # default: <repo>/results   (Colab: /content/drive/MyDrive/krs/results)
KRS_MODELS_DIR=           # default: <repo>/models    (Colab: /content/drive/MyDrive/krs/models)
